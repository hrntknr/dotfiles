{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "read": {
      "*": "allow",
    },
    "edit": {
      "*": "allow",
    },
  },
  "agent": {
    "advisor": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "description": "Read-only advisor for design discussions",
      "permission": {
        "edit": "deny",
        "bash": "deny",
      },
      "prompt": "Inspect the code and suggest concise design and implementation approaches.",
    },
  },
  "worktree": {
    "directory": "../wt",
  },
}
