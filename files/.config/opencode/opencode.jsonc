{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.local.md"],
  "experimental": {
    "schedules": true,
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
  ],
  "agents": {
    "advisor": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "description": "Read-only advisor for design discussions",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
      ],
      "system": "Inspect the code and suggest concise design and implementation approaches.",
    },
  },
  "worktree": {
    "directory": "../wt",
  },
  "skills": [
    "https://raw.githubusercontent.com/hrntknr/browser-box/main/.opencode/skills/",
  ],
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
      },
    },
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "deny",
    },
    {
      "action": "integration.use",
      "resource": "skill:report",
      "effect": "deny",
    },
    {
      "action": "integration.use",
      "resource": "skill:browser",
      "effect": "deny",
    },
  ],
}
