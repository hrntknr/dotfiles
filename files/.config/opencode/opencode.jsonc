{
  "$schema": "https://opencode.ai/config.json",
  "model": "localhost/moonshotai/kimi-k3",
  "small_model": "localhost/moonshotai/kimi-k3",
  "permission": {
    "external_directory": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.vault_password": "deny",
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.vault_password": "deny",
    },
  },
  "provider": {
    "localhost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "localhost",
      "options": {
        "baseURL": "http://localhost:8080/v1",
      },
      "models": {
        "moonshotai/kimi-k3": {},
      },
    },
  },
}
