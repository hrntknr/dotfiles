{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",
  "permission": {
    "external_directory": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.vault_password": "deny",
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.vault_password": "deny",
    },
  },
  "provider": {
    "localhost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "localhost",
      "options": {
        "baseURL": "http://localhost:8000/v1",
      },
      "models": {
        "z-ai/glm-5.2": {},
      },
    },
  },
}
